{
  "apiVersion": "acr.dev/v1alpha1",
  "kind": "Contract",
  "metadata": {
    "id": "deny-secret-file-write",
    "version": 1,
    "title": "禁止 Agent 改写密钥文件",
    "status": "active",
    "severity": "critical",
    "priority": 950,
    "tags": ["filesystem", "secrets", "cross-agent"]
  },
  "scope": {
    "operation_kinds": ["filesystem.write"]
  },
  "applicability": {
    "all": [
      {
        "field": "paths",
        "operator": "glob",
        "value": "**/.env*"
      }
    ]
  },
  "behavior": {
    "instruction": ".env 及 .env.example 等同类文件由人维护，Agent 不得修改；需要新增配置项时告诉用户要加什么",
    "enforcement": "hard",
    "non_overridable": true
  },
  "correction": {
    "mode": "deny"
  },
  "failure_mode": "closed"
}
